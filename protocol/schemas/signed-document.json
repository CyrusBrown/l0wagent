{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.l0wagent.invalid/0.1/signed-document.json",
  "title": "signed-document",
  "description": "The envelope of every signed document. Signing input: 'l0wagent-sig/1' LF type LF payload (the base64url string).",
  "type": "object",
  "required": [
    "v",
    "type",
    "payload",
    "sigs"
  ],
  "properties": {
    "v": {
      "const": "l0w/0.1"
    },
    "type": {
      "type": "string"
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "base64url, no padding"
    },
    "sigs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kid",
          "sig"
        ],
        "properties": {
          "kid": {
            "type": "string",
            "pattern": "^k1\\.[A-Za-z0-9_-]{22}$"
          },
          "sig": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "base64url, no padding"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
