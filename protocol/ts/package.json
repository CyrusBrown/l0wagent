{
  "name": "@l0w/proto",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript reference library of the l0wagent hub protocol (l0w/0.1), for hub services on Cloudflare Workers. Mirrors protocol/py (l0wproto).",
