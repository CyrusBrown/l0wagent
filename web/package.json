{
  "name": "l0wagent-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test && playwright test -c playwright.hub.config.ts",
    "gen:api": "openapi-typescript ../control/openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../control/openapi.json --default-non-nullable false -o /tmp/l0w-schema-check.d.ts && diff -q /tmp/l0w-schema-check.d.ts src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tanstack/react-query": "^5.107.1",
    "occt-import-js": "^0.0.23",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "5.4.149",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-sanitize": "^6.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
